from pyspark.sql import SparkSession
from pyspark.sql.functions import col

spark = SparkSession.builder \
    .appName("taxi_location_analysis") \
    .getOrCreate()

raw_path = "data/raw/"
outpt_path = "data/output/"

df_clean_trip = spark.read.option("header","true").option("inferschema","true").csv(f"{outpt_path}clean_trips_2025_sample.csv")
df_clean_trip.printSchema()

df_lookup = spark.read.option("header","true").option("inferschema","true").csv(f"{raw_path}taxi_zone_lookup.csv")
df_lookup.printSchema()

df_join = df_clean_trip.join(df_lookup, df_clean_trip.PULocationID = df_lookup.LocationID, 'inner') \
.select("Borough","pickup_month","total_amount","trip_distance")

df_final = df_join\
.groupBy("Borough","pickup_month") \
.agg(
    count("*").alias("trip_count"),
    sum(col("total_amount")).alias("total_revenue") ,
    avg(col("trip_distance")).alias("avg_trip_distance")
)

df_final.printSchema()
df_final.limit(5).show()

df_final.toPandas.to_csv(f"{output_path}location_kpi_2025.csv", index=Flase)