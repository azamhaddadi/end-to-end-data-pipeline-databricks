from pyspark.sql import SparkSession
from pyspark.sql.functions import col, count, sum, avg, round

spark = SparkSession.builder \
        .appName("taxi_transform") \
        .getOrCreate()

raw_path = "data/raw/"
output_path = "data/output/"

df_clean_data_2025 = spark.read.option("header", "true").option("inferSchema", "true").csv(f"{output_path}clean_trips_2025_sample.csv")

df_clean_data_2025.printSchema()
df_clean_data_2025.show(5)


df_clean_data_2025_trans = df_clean_data_2025\
.groupBy("pickup_month")\
.agg(
count("*").alias("trip_count"),
sum(col("total_amount")).alias("total_revenue"),
avg(col("trip_distance")).alias("avg_trip_distance")
            )




df_clean_data_2025_trans.toPandas().to_csv(f"{output_path}kpi_2025_final.csv", index=False)